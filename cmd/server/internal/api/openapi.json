{
  "openapi": "3.0.3",
  "info": {
    "title": "Knowledge built-in app API",
    "version": "v1",
    "description": "Read collections, documents and search hits visible to the authenticated Project member or Access Key. Exchange an opaque apk_ key at the Platform API /api/v1/access/token endpoint, then send the returned short-lived assertion. Keys require search for search/answer, documents:read for collection/document reads, and documents:write for document mutations and ingestion job reads. Keys cannot administer sources or collections and cannot access group-restricted collections."
  },
  "x-appthrust-definition": "knowledge",
  "servers": [{"url": "/api/knowledge/v1"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/collections": {
      "get": {
        "operationId": "listCollections",
        "summary": "List visible collections",
        "x-appthrust-link": true,
        "x-appthrust-result-path": "data",
        "responses": {
          "200": {"description": "Visible collections, ordered by name", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CollectionList"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "search",
        "summary": "Search visible document chunks",
        "x-appthrust-link": true,
        "x-appthrust-result-path": "hits",
        "parameters": [
          {"name": "query", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1}, "description": "Nonblank query, at most 16384 UTF-8 bytes after trimming"},
          {"name": "collections", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}, "style": "form", "explode": false, "description": "Comma-separated collection names; omit to search all visible collections"},
          {"name": "topK", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 50, "default": 8}, "description": "Maximum hits, 1 to 50; omitted or zero uses 8"},
          {"name": "rerank", "in": "query", "schema": {"type": "boolean", "default": false}, "description": "Order the fused documents with the configured LLM (one call); 503 knowledge_llm_unavailable without an LLM"},
          {"name": "expand", "in": "query", "schema": {"type": "boolean", "default": false}, "description": "Fuse the results of LLM-generated official terms and rephrasings with the query's (one call); 503 knowledge_llm_unavailable without an LLM"}
        ],
        "responses": {
          "200": {"description": "Ranked visible hits using hybrid search", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchResult"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      },
      "post": {
        "operationId": "searchPost",
        "summary": "Search visible document chunks",
        "x-appthrust-result-path": "hits",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchRequest"}}}},
        "responses": {
          "200": {"description": "Ranked visible hits", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchResult"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/documents": {
      "get": {
        "operationId": "listDocuments",
        "summary": "List visible documents",
        "description": "Filters collections by caller visibility before applying the result limit. Unknown or inaccessible collections return an empty list. Documents are ordered by most recently updated, then ID.",
        "x-appthrust-link": true,
        "x-appthrust-result-path": "data",
        "parameters": [
          {"name": "collection", "in": "query", "description": "Collection name; omit to include all visible collections", "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "description": "Maximum documents to return", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}}
        ],
        "responses": {
          "200": {"description": "Bounded visible documents", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DocumentList"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/documents/{id}": {
      "get": {
        "operationId": "getDocument",
        "summary": "Get a visible document",
        "x-appthrust-link": true,
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Visible document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/KnowledgeDocument"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"description": "Document is absent or not visible", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/sources": {
      "get": {
        "operationId": "listSources",
        "summary": "List visible sources and their latest durable sync jobs (Editor/Admin)",
        "responses": {
          "200": {"description": "Visible sources", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Source"}}}}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/sources/{id}": {
      "get": {
        "operationId": "getSource",
        "summary": "Get a visible source and its latest sync job (Editor/Admin)",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Visible source", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      },
      "delete": {
        "operationId": "deleteSource",
        "summary": "Delete a source and every document it ingested (Editor/Admin)",
        "description": "Manually posted documents in the collection stay. Refused with 409 knowledge_source_syncing while the source's sync job is queued or running.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Deleted; `documents` counts the removed documents", "content": {"application/json": {"schema": {"type": "object", "required": ["deleted", "documents"], "properties": {"deleted": {"type": "boolean"}, "documents": {"type": "integer", "minimum": 0}}}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/sources/{id}/sync": {
      "post": {
        "operationId": "syncSource",
        "summary": "Queue a source sync (Editor/Admin)",
        "description": "Returns the existing queued/running job for this source, or creates one. Poll GET /jobs/{id} or GET /sources. Per-document errors are recorded in result.errors; a discovery failure sets the job to failed. lastSync remains the last successful job's result. A walk that completes without any error also removes this source's documents the source no longer returned (result.removed); a failed or partially failed walk removes nothing.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "202": {"description": "Durably queued or already active", "content": {"application/json": {"schema": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/components/schemas/IngestJob"}}}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get an ingestion job (Editor/Admin)",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Job visible to the caller", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IngestJob"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "description": "Project member OIDC bearer or ES256 Access Assertion JWT, verified by Knowledge for its issuer and audience. Raw apk_ keys are rejected with raw_key_not_accepted; exchange them first."}
    },
    "responses": {
      "Unauthorized": {"description": "A valid bearer token is required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Forbidden": {"description": "The caller is not a Project member, lacks the required key scope, or uses a key on a management route", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InvalidRequest": {"description": "Request parameters are invalid", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Error": {"description": "Request failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "SyncResult": {
        "type": "object",
        "required": ["documents", "chunks", "removed", "errors", "finishedAt"],
        "properties": {
          "documents": {"type": "integer", "minimum": 0},
          "chunks": {"type": "integer", "minimum": 0},
          "removed": {"type": "integer", "minimum": 0, "description": "Documents deleted because an error-free walk no longer returned them"},
          "errors": {"type": "array", "items": {"type": "string"}},
          "finishedAt": {"type": "string", "format": "date-time"}
        }
      },
      "IngestJob": {
        "type": "object",
        "required": ["id", "kind", "state", "progress", "result", "error", "createdAt", "startedAt", "finishedAt"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["sync", "reembed"]},
          "state": {"type": "string", "enum": ["queued", "running", "done", "failed"]},
          "progress": {
            "type": "object",
            "required": ["documents", "chunks", "total"],
            "properties": {
              "documents": {"type": "integer", "minimum": 0},
              "chunks": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0, "nullable": true}
            }
          },
          "result": {"allOf": [{"$ref": "#/components/schemas/SyncResult"}], "nullable": true},
          "error": {"type": "string", "nullable": true},
          "createdAt": {"type": "string", "format": "date-time"},
          "startedAt": {"type": "string", "format": "date-time", "nullable": true},
          "finishedAt": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "Source": {
        "type": "object",
        "required": ["id", "type", "collection", "config", "lastSync", "sync"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["notion", "esa"]},
          "collection": {"type": "string"},
          "config": {"type": "object", "additionalProperties": true, "description": "Provider settings, never containing the stored token"},
          "tokenSource": {"type": "string", "enum": ["stored", "platform"]},
          "lastSync": {"allOf": [{"$ref": "#/components/schemas/SyncResult"}], "nullable": true},
          "sync": {"allOf": [{"$ref": "#/components/schemas/IngestJob"}], "nullable": true, "description": "Latest sync job, regardless of state"}
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {"error": {"type": "string"}, "message": {"type": "string"}}
      },
      "Visibility": {
        "type": "object",
        "required": ["groups"],
        "properties": {"groups": {"type": "array", "items": {"type": "string"}, "description": "Empty groups make a collection visible to all Project members and keys with the required operation scope"}}
      },
      "Collection": {
        "type": "object",
        "required": ["name", "description", "visibility"],
        "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "visibility": {"$ref": "#/components/schemas/Visibility"}}
      },
      "CollectionList": {
        "type": "object",
        "required": ["data"],
        "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Collection"}}}
      },
      "KnowledgeDocument": {
        "type": "object",
        "required": ["id", "collection", "title", "url", "content", "metadata", "chunks"],
        "properties": {
          "id": {"type": "string"},
          "collection": {"type": "string"},
          "externalId": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "content": {"type": "string"},
          "metadata": {"type": "object", "additionalProperties": true},
          "chunks": {"type": "integer", "minimum": 0}
        }
      },
      "DocumentList": {
        "type": "object",
        "required": ["data"],
        "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/KnowledgeDocument"}}}
      },
      "SearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": {"type": "string", "minLength": 1, "description": "Nonblank query, at most 16384 UTF-8 bytes after trimming"},
          "collections": {"type": "array", "items": {"type": "string"}, "description": "Restrict to visible collections with these names; empty means all visible collections"},
          "topK": {"type": "integer", "minimum": 0, "maximum": 50, "default": 8, "description": "Maximum hits, 1 to 50; omitted or zero uses 8"},
          "mode": {"type": "string", "enum": ["hybrid", "lexical", "vector"], "default": "hybrid"},
          "rerank": {"type": "boolean", "default": false, "description": "Order the fused documents with the configured LLM (one call); 503 knowledge_llm_unavailable without an LLM"},
          "expand": {"type": "boolean", "default": false, "description": "Fuse the results of LLM-generated official terms and rephrasings with the query's (one call); 503 knowledge_llm_unavailable without an LLM"}
        }
      },
      "SearchHit": {
        "type": "object",
        "required": ["documentId", "title", "url", "collection", "chunkIndex", "text", "score"],
        "properties": {
          "documentId": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "collection": {"type": "string"},
          "chunkIndex": {"type": "integer", "minimum": 0},
          "text": {"type": "string"},
          "score": {"type": "number", "format": "double"},
          "metadata": {"type": "object", "additionalProperties": true, "description": "Connector metadata of the document (esa: number, category, tags, updatedAt, watchers, stars, comments); absent when empty"}
        }
      },
      "SearchResult": {
        "type": "object",
        "required": ["hits", "mode", "reranked", "expanded", "embedding"],
        "properties": {
          "hits": {"type": "array", "items": {"$ref": "#/components/schemas/SearchHit"}},
          "mode": {"type": "string", "enum": ["hybrid", "lexical", "vector"]},
          "reranked": {"type": "boolean"},
          "expanded": {"type": "array", "items": {"type": "string"}, "description": "Formulations the LLM added when expand was requested; empty otherwise"},
          "embedding": {"type": "object", "required": ["provider", "source"], "properties": {"provider": {"type": "string"}, "source": {"type": "string", "description": "Display identity of the embedding source: embedding (built-in app), openai (hosted), custom (explicit endpoint), or hashing"}}}
        }
      }
    }
  }
}
